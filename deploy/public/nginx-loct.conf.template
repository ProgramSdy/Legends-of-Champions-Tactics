# Template only. Replace all REQUIRED values and validate with `nginx -t`.
server {
    listen 80;
    listen [::]:80;
    server_name REQUIRED_PUBLIC_HOSTNAME;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name REQUIRED_PUBLIC_HOSTNAME;

    ssl_certificate /etc/letsencrypt/live/REQUIRED_PUBLIC_HOSTNAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REQUIRED_PUBLIC_HOSTNAME/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;

    location /api/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Overwrite rather than append: the API accepts one address only.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 65s;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 65s;
    }
}
