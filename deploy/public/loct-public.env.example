# Template only. Copy to a root-owned file outside the checkout (mode 0600).
# Replace every REQUIRED value before starting the Public API.
LOCT_RELEASE_MODE=public
LOCT_BUILD_VERSION=REQUIRED_RELEASE_IDENTIFIER
BATTLE_API_PUBLIC_DB=/var/lib/loct/public/player.sqlite3
BATTLE_API_PUBLIC_ORIGIN=https://REQUIRED_PUBLIC_HOSTNAME
BATTLE_API_PUBLIC_HMAC_KEY=REQUIRED_RANDOM_SECRET_AT_LEAST_32_BYTES
BATTLE_API_RATE_LIMIT_HMAC_KEY=REQUIRED_SEPARATE_RANDOM_SECRET_AT_LEAST_32_BYTES
BATTLE_API_PUBLIC_HMAC_KEY_VERSION=1
BATTLE_API_TRUSTED_PROXY_IPS=127.0.0.1
BATTLE_API_PUBLIC_BATTLE_CAPACITY=20
BATTLE_API_PUBLIC_PROVISIONAL_TTL_SECONDS=120
BATTLE_API_PUBLIC_INACTIVITY_SECONDS=1800

# Deliberately absent: BATTLE_API_ENABLE_PUBLIC_BATTLES.
# Public battle access remains fail-closed until the owner separately authorizes launch.
